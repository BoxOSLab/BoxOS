+#[cfg(test)]
+pub fn set_bank_reg(tracee: &mut Tracee, version: RegVersion, reg: Reg, value: Word) {
+    let off = reg_offsets(tracee, version)[reg as usize];
+    reg_write(&mut tracee.regs[version.idx()], off, value);
+}
