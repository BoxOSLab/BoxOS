 #[cfg(test)]
+pub fn set_bank_compat(tracee: &mut Tracee, version: RegVersion, compat: bool) {
+    let regs = &mut tracee.regs[version.idx()];
+    #[cfg(target_arch = "x86_64")]
+    {
+        regs.cs = if compat { 0x23 } else { 0x33 };
+        regs.ds = 0;
+    }
+    #[cfg(target_arch = "aarch64")]
+    {
+        regs.compat = compat;
+    }
+}
